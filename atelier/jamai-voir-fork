#!/usr/bin/env python3
"""jamai-voir-fork — regarder une session Claude en direct, sans la déranger.

Le fork tourne en arrière-plan : il n'a pas de terminal, et on ne peut pas
déplacer un processus vivant dans un pane. Mais sa transcription s'écrit sur
disque au fil de l'eau. On la suit, on l'imprime lisiblement, et on ne touche
à rien : lecture seule, aucun signal, aucune écriture.

Usage :  jamai-voir-fork <session-id|chemin.jsonl>
"""
import json, os, sys, time, textwrap

G, D, J, B, R = "\033[32m", "\033[2m", "\033[33m", "\033[36m", "\033[0m"

def chemin(arg):
    if os.path.isfile(arg):
        return arg
    base = os.path.expanduser("~/.claude/projects")
    for rac, _, fics in os.walk(base):
        for f in fics:
            if f.startswith(arg) and f.endswith(".jsonl"):
                return os.path.join(rac, f)
    sys.exit(f"session introuvable : {arg}")

def texte(msg):
    c = msg.get("content")
    if isinstance(c, str):
        return [("txt", c)]
    out = []
    for bloc in c or []:
        t = bloc.get("type")
        if t == "text" and bloc.get("text", "").strip():
            out.append(("txt", bloc["text"]))
        elif t == "tool_use":
            out.append(("out", bloc.get("name", "?")))
    return out

def montre(ev):
    m = ev.get("message") or {}
    role = m.get("role")
    if role not in ("assistant", "user"):
        return
    for genre, val in texte(m):
        if genre == "out":
            print(f"  {D}· {val}{R}", flush=True)
        elif role == "assistant":
            for para in val.strip().split("\n"):
                print(textwrap.fill(para, 96, initial_indent="  ",
                                    subsequent_indent="  ") or "", flush=True)
            print(flush=True)
        else:
            tete = " ".join(val.split())[:150]
            if tete and not tete.startswith("<"):
                print(f"\n{J}▸ {tete}{R}\n", flush=True)

f = chemin(sys.argv[1] if len(sys.argv) > 1 else "")
print(f"{B}── en direct : {os.path.basename(f)} ──{R}")
print(f"{D}   lecture seule · la session n'est ni touchée ni ralentie{R}\n", flush=True)

with open(f, "r", errors="replace") as fh:
    fh.seek(0, os.SEEK_END)          # on ne rejoue pas le passé, on suit la suite
    while True:
        ligne = fh.readline()
        if not ligne:
            time.sleep(0.4)
            continue
        try:
            montre(json.loads(ligne))
        except Exception:
            pass
