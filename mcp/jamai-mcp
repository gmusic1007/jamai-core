import jamai_ws  # noqa: E402

LIVE_ACTIONS = ["ping", "getScore", "getCursorInfo", "undo", "goToBeginningOfScore", "goToFinalMeasure",
                "goToMeasure", "nextElement", "prevElement", "nextStaff", "prevStaff", "selectCurrentMeasure",
                "selectCustomRange", "syncStateToSelection", "addNote", "addRest", "addTuplet", "addLyrics",
                "appendMeasure", "insertMeasure", "deleteSelection", "setTimeSignature", "setTempo",
                "addInstrument", "setStaffMute", "setInstrumentSound", "processSequence", "addDynamic", "version",
                "addElement", "setScoreText", "newScore", "openScore", "saveScore"]
_LIVE = {"client": None}


def live_command(action, params=None):
    """One command to the running MuseScore plugin, on a kept connection, reconnecting once."""
    for attempt in (1, 2):
        try:
            if _LIVE["client"] is None:
                _LIVE["client"] = jamai_ws.Client().connect()
            return _LIVE["client"].command(action, params or {})
        except (jamai_ws.WebSocketError, OSError) as exc:
            if _LIVE["client"] is not None:
                _LIVE["client"].close()
                _LIVE["client"] = None
            if attempt == 2:
                raise jamai_ws.WebSocketError(str(exc))


def live_text(action, params=None):
    try:
        reply = live_command(action, params)
    except jamai_ws.WebSocketError as exc:
        return str(exc), True
    text = json.dumps(reply, ensure_ascii=False, indent=1)
    if len(text) > LIMIT:
        text = text[:LIMIT] + "\n… (%d more characters not shown)" % (len(text) - LIMIT)
    return text, reply.get("status") != "success"


def t_live_status(a):
    text, failed = live_text("ping")
    if failed:
        return text, True
    cursor, _ = live_text("getCursorInfo")
    return "MuseScore is listening: changes sent with musescore_live appear in the open score.\nCursor:\n" + cursor, False


def t_live_score(a):
    return live_text("getScore")


def t_live(a):
    action = str(a["action"])
    if action not in LIVE_ACTIONS:
        return "unknown action %s. Known: %s" % (action, ", ".join(LIVE_ACTIONS)), True
    params = a.get("params") or {}
    if not isinstance(params, dict):
        return "params must be an object", True
    return live_text(action, params)


def t_export(a):
    args = [tool("render/jamai-musescore"), "--export", ",".join(a.get("formats") or ["pdf"])]
    if a.get("parts"):
        args.append("--parts")
    if a.get("transpose_semitones"):
        args += ["--transpose-semitones", str(int(a["transpose_semitones"]))]
    if a.get("out"):
        args += ["--out", str(a["out"])]
    return run(args + [str(a["path"])], timeout=900)


def t_video(a):
