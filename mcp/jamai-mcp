def t_melodies(a):
    path = os.path.join(CFG["JAMAI_MELODY_DIR"], "melodies.json")
    try:
        with open(path, encoding="utf-8") as fh:
            manifest = json.load(fh)
    except (OSError, ValueError):
        return "no melody has been published in %s yet" % CFG["JAMAI_MELODY_DIR"], False
    rows = ["%s  %s  %s  %s  %ss  %s" % (m.get("date", ""), m.get("slug", ""), m.get("key", ""),
                                         m.get("meter", ""), m.get("duration_seconds", "?"), m.get("title", ""))
            for m in manifest[: int(a.get("limit", 20))]]
    return "%d melodies in %s\n%s" % (len(manifest), CFG["JAMAI_MELODY_DIR"], "\n".join(rows)), False


def t_events(a):
    path = os.path.join(CFG["JAMAI_STATE_DIR"], "events", "ledger.jsonl")
    try:
        with open(path, encoding="utf-8") as fh:
            lines = [line.strip() for line in fh if line.strip()]
    except OSError:
        return "no fact has been announced yet (%s does not exist)" % path, False
    return "\n".join(lines[-int(a.get("limit", 10)):]) or "the ledger is empty", False


