#!/usr/bin/env python3
"""jamai-mcp — the jamai-core tools as an MCP server, over stdio.

An agent that speaks the Model Context Protocol can listen to a recording (tempo, beats,
chords, key, lyrics, melody, the voice apart from the guitar), render ABC, read a MIDI file,
name its chords, draw a tablature, publish a melody and read what was announced, without
knowing where this checkout lives.

  Claude Code:   claude mcp add jamai -- jamai-mcp
  Any client:    {"mcpServers": {"jamai": {"command": "jamai-mcp"}}}

It runs the same commands a person runs, with the same settings (`jamai config show`).
`jamai_publish_melody` is the only tool that changes a published page: call it when the
person asked for a publication, never as a side effect.

Python standard library only. One JSON-RPC message per line.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import jamai_env  # noqa: E402

CFG = jamai_env.load()
ROOT = jamai_env.ROOT
LIMIT = 20000          # characters of tool output returned to the agent
try:
    VERSION = open(os.path.join(ROOT, "VERSION"), encoding="utf-8").read().strip()
except OSError:
    VERSION = "unknown"


def run(args, stdin=None, timeout=300):
    try:
        done = subprocess.run(args, input=stdin, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return "timed out after %d s: %s" % (timeout, " ".join(args)), True
    except OSError as exc:
        return "could not run %s: %s" % (args[0], exc), True
    text = (done.stdout + ("\n" + done.stderr if done.stderr.strip() else "")).strip()
    if len(text) > LIMIT:
        text = text[:LIMIT] + "\n… (%d more characters not shown)" % (len(text) - LIMIT)
    if done.returncode != 0:
        text = (text + "\n" if text else "") + "exit code %d" % done.returncode
    return text or "(no output)", done.returncode != 0


def tool(path):
    return os.path.join(ROOT, path)


def t_doctor(a):
    return run([tool("bin/jamai"), "doctor"])


def t_config(a):
    return run([tool("bin/jamai"), "config", "show"])


def t_render(a):
    args = [tool("render/jamai-render")]
    if a.get("name"):
        args += ["--name", str(a["name"])]
    return run(args + ["-"], stdin=str(a["abc"]))


def t_midi_notes(a):
