sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import jamai_env  # noqa: E402

CFG = jamai_env.load()
ROOT = jamai_env.ROOT
STATE = CFG["JAMAI_STATE_DIR"]
HUB_DIR = os.path.join(STATE, "hub")
LEDGER = os.path.join(STATE, "events", "ledger.jsonl")
SUBS_FILE = os.path.join(HUB_DIR, "subscriptions.json")
INVITES_FILE = os.path.join(HUB_DIR, "invites.json")
DELIVERIES = os.path.join(HUB_DIR, "deliveries.jsonl")
LOCK_FILE = os.path.join(HUB_DIR, ".lock")
MELODY_DIR = CFG["JAMAI_MELODY_DIR"]
EVENT_TYPES = ("melody.published", "melody.revised")
BACKOFF = (60, 300, 1800, 7200, 21600)      # seconds before attempt 2, 3, 4, 5, 6
MAX_BODY = 8192
try:
    VERSION = open(os.path.join(ROOT, "VERSION"), encoding="utf-8").read().strip()
except OSError:
    VERSION = "unknown"

mimetypes.add_type("text/vnd.abc", ".abc")
mimetypes.add_type("audio/midi", ".mid")
mimetypes.add_type("image/svg+xml", ".svg")


def flag(name):
    return CFG.get(name, "0") == "1"


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# ── files ────────────────────────────────────────────────────────────
class locked:
    """One writer at a time across the server and the command line."""

    def __enter__(self):
        os.makedirs(HUB_DIR, mode=0o700, exist_ok=True)
        self.fh = open(LOCK_FILE, "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=1, ensure_ascii=False)
    os.replace(tmp, path)


def read_jsonl(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                if isinstance(row, dict):
                    rows.append(row)
    except OSError:
        pass
    return rows


def append_jsonl(path, row):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")


def facts():
    return [f for f in read_jsonl(LEDGER) if f.get("id") and f.get("type")]


def public_sub(sub):
    return {k: v for k, v in sub.items() if k != "secret"}


# ── the webhook target ───────────────────────────────────────────────
def check_target(url):
    """Return (parsed, address, None) when the hub may POST to url, else (None, None, reason)."""
    try:
        parts = urllib.parse.urlsplit(url)
    except ValueError:
        return None, None, "the address is not a URL"
    allow_private = flag("JAMAI_HUB_ALLOW_PRIVATE_TARGETS")
    if parts.scheme != "https" and not (allow_private and parts.scheme == "http"):
        return None, None, "the address must start with https://"
    if not parts.hostname or parts.username or parts.password:
        return None, None, "the address needs a host name and no user or password"
    if len(url) > 2000:
        return None, None, "the address is too long"
    port = parts.port or (443 if parts.scheme == "https" else 80)
    try:
        infos = socket.getaddrinfo(parts.hostname, port, type=socket.SOCK_STREAM)
    except (socket.gaierror, UnicodeError):
        return None, None, "the host name does not resolve"
    addresses = [info[4][0] for info in infos]
    if not addresses:
        return None, None, "the host name does not resolve"
    if not allow_private:
        for addr in addresses:
            ip = ipaddress.ip_address(addr.split("%")[0])
            if not ip.is_global or ip.is_multicast:
                return None, None, "the address points inside a private network"
    return parts, addresses[0], None


class PinnedHTTPS(http.client.HTTPSConnection):
    """TLS to the host name, over a socket opened to the address that was checked."""

    def __init__(self, host, address, **kw):
        super().__init__(host, **kw)
        self._address = address

    def connect(self):
        sock = socket.create_connection((self._address, self.port), self.timeout)
        self.sock = self._context.wrap_socket(sock, server_hostname=self.host)


class PinnedHTTP(http.client.HTTPConnection):
    def __init__(self, host, address, **kw):
        super().__init__(host, **kw)
        self._address = address

    def connect(self):
        self.sock = socket.create_connection((self._address, self.port), self.timeout)


def post_fact(sub, fact):
    """POST one fact to one subscription. Return (delivered, http status or 0, short reason)."""
    parts, address, reason = check_target(sub["url"])
    if reason:
        return False, 0, reason
    body = json.dumps(fact, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    signature = hmac.new(sub["secret"].encode(), body, hashlib.sha256).hexdigest()
    path = parts.path or "/"
    if parts.query:
        path += "?" + parts.query
    cls = PinnedHTTPS if parts.scheme == "https" else PinnedHTTP
    conn = cls(parts.hostname, address, port=parts.port, timeout=10)
    try:
        conn.request("POST", path, body=body, headers={
            "Content-Type": "application/json",
            "User-Agent": "jamai-hub/" + VERSION,
            "X-JamAI-Event": fact["type"],
            "X-JamAI-Fact": fact["id"],
            "X-JamAI-Delivery": str(uuid.uuid4()),
            "X-JamAI-Signature": "sha256=" + signature,
        })
        status = conn.getresponse().status
    except (OSError, http.client.HTTPException) as exc:
        return False, 0, type(exc).__name__
    finally:
        conn.close()
    return 200 <= status < 300, status, "" if 200 <= status < 300 else "the receiver answered %d" % status


# ── delivery ─────────────────────────────────────────────────────────
def delivery_index():
    """(subscription id, fact id) → the last attempt recorded for that pair."""
    index = {}
    for row in read_jsonl(DELIVERIES):
        index[(row.get("sub"), row.get("fact"))] = row
    return index


SEEN = set()                                   # the fact ids in the ledger at the previous delivery pass


def reanchor(sub, lost, last_seen):
    """Move a subscription whose anchor fact left the ledger to last_seen ("" = the start)."""
    with locked():
        subs = read_json(SUBS_FILE, {})
        kept = subs.get(sub["id"])
        if kept and kept.get("after_fact") == lost:
            kept["after_fact"] = last_seen
            write_json(SUBS_FILE, subs)
    sub["after_fact"] = last_seen
    print("jamai-hub: %s lost its anchor %s; it now receives what follows %s"
          % (sub["id"], lost, last_seen or "the start of the ledger"), file=sys.stderr, flush=True)


def deliver_due():
    global SEEN
    all_facts = facts()
    ids = [f["id"] for f in all_facts]
    seen, SEEN = SEEN, set(ids)
    subs = read_json(SUBS_FILE, {})
    if not subs:
        return 0
    index = delivery_index()
    sent = 0
    for sub in subs.values():
        # A subscription receives what is announced after it. The line is drawn by position in
        # the ledger, not by the clock: two stamps one second apart cannot be ordered reliably.
        anchor = sub.get("after_fact")
        if not anchor:                         # None, or "" = subscribed on an empty ledger: all of it
            start = 0
        elif anchor in ids:
            start = len(ids) - ids[::-1].index(anchor)
        else:
            # The anchor left the ledger (rotated or edited). Start after the last fact the hub
            # had already seen at its previous pass: what was announced since still arrives, and
            # nothing older is sent again. With no previous pass (the hub just started), start
            # after the last fact there. The new anchor is kept, so later facts reach it too.
            start = next((i + 1 for i in range(len(ids) - 1, -1, -1) if ids[i] in seen),
                         0 if seen else len(ids))
            reanchor(sub, anchor, ids[start - 1] if start else "")
        for fact in all_facts[start:]:
            if fact["type"] not in sub.get("events", EVENT_TYPES):
                continue
            last = index.get((sub["id"], fact["id"]))
            attempt = 1
            if last:
                if last.get("status") in ("delivered", "abandoned"):
                    continue
                attempt = int(last.get("attempt", 1)) + 1
                if time.time() < float(last.get("epoch", 0)) + BACKOFF[min(attempt - 2, len(BACKOFF) - 1)]:
                    continue
            ok, status, reason = post_fact(sub, fact)
            state = "delivered" if ok else ("abandoned" if attempt > len(BACKOFF) else "failed")
            with locked():
                append_jsonl(DELIVERIES, {"sub": sub["id"], "fact": fact["id"], "type": fact["type"],
                                          "status": state, "http": status, "reason": reason,
                                          "attempt": attempt, "at": now_iso(), "epoch": int(time.time())})
            sent += 1
    return sent


def worker(stop):
    while not stop.is_set():
        try:
            deliver_due()
        except Exception as exc:               # the worker must outlive one bad row
            print("jamai-hub: delivery pass failed: %r" % (exc,), file=sys.stderr, flush=True)
        stop.wait(3)


