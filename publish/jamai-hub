INVITE_FIELD = ('<label for="invite">Invite code</label>'
                '<input id="invite" name="invite" required autocomplete="off">')


def render_page():
    page = PAGE.replace("__TITLE__", html.escape(CFG.get("JAMAI_SITE_TITLE", "JamAI")))
    page = page.replace("__TAGLINE__", html.escape(CFG.get("JAMAI_SITE_TAGLINE", "")))
    page = page.replace("__GLYPHS__", html.escape(CFG.get("JAMAI_SITE_GLYPHS", "")))
    page = page.replace("__INVITE__", "" if flag("JAMAI_HUB_OPEN_SUBSCRIPTIONS") else INVITE_FIELD)
    return page.replace("__VERSION__", html.escape(VERSION))


# ── http ─────────────────────────────────────────────────────────────
ATTEMPTS = {}            # client address → [epoch, …] of subscribe attempts in the last hour
ATTEMPTS_LOCK = threading.Lock()


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "jamai-hub/" + VERSION
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        print("%s %s" % (self.client(), fmt % args), file=sys.stderr, flush=True)

    def client(self):
        peer = self.client_address[0]
        if ipaddress.ip_address(peer).is_loopback:          # behind a local reverse proxy
            forwarded = self.headers.get("X-Forwarded-For", "")
            if forwarded:
                return forwarded.split(",")[0].strip()
        return peer

    def send_json(self, status, data):
        body = json.dumps(data, ensure_ascii=False, indent=1).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def read_body(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            return None
        if length > MAX_BODY:
            return None
        try:
            data = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return None
        return data if isinstance(data, dict) else None

    def bearer(self):
        value = self.headers.get("Authorization", "")
        return value[7:].strip() if value.startswith("Bearer ") else ""

    def is_admin(self):
        token = CFG.get("JAMAI_HUB_ADMIN_TOKEN", "")
        return bool(token) and hmac.compare_digest(self.bearer().encode(), token.encode())

    def owned(self, sub_id):
        """The subscription when the caller holds its secret or the admin token, else None."""
        sub = read_json(SUBS_FILE, {}).get(sub_id)
        if not sub:
            return None
        if self.is_admin() or hmac.compare_digest(self.bearer().encode(), sub["secret"].encode()):
            return sub
        return None

    # GET and HEAD
    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        url = urllib.parse.urlsplit(self.path)
        path, query = url.path, urllib.parse.parse_qs(url.query)
        if path in ("/", "/index.html"):
            body = render_page().encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)
        elif path == "/healthz":
            self.send_json(200, {"ok": True, "version": VERSION})
        elif path == "/melody":
            self.send_response(301)
            self.send_header("Location", "melody/")
            self.send_header("Content-Length", "0")
            self.end_headers()
        elif path.startswith("/melody/"):
            self.send_static(path[len("/melody/"):])
        elif path == "/api/events":
            rows = facts()
            after = query.get("after", [""])[0]
            if after:
                ids = [f["id"] for f in rows]
                rows = rows[ids.index(after) + 1:] if after in ids else rows
            try:
                limit = max(1, min(200, int(query.get("limit", ["50"])[0])))
            except ValueError:
                limit = 50
            rows = rows[-limit:] if query.get("latest") else rows[:limit]
            self.send_json(200, {"events": rows})
        elif path == "/api/melodies":
            manifest = read_json(os.path.join(MELODY_DIR, "melodies.json"), [])
            keep = ("slug", "title", "date", "key", "meter", "tempo", "duration_seconds", "video", "published_at")
            self.send_json(200, {"melodies": [{k: m.get(k) for k in keep} for m in manifest if isinstance(m, dict)]})
        elif path == "/api/admin/subscriptions":
            if not self.is_admin():
                return self.send_json(401, {"error": "the admin token is needed"})
            self.send_json(200, {"subscriptions": [public_sub(s) for s in read_json(SUBS_FILE, {}).values()]})
        elif re.fullmatch(r"/api/subscriptions/[A-Za-z0-9_-]+", path):
            sub = self.owned(path.rsplit("/", 1)[1])
            if not sub:
                return self.send_json(404, {"error": "no subscription with this id and secret"})
            rows = [r for r in read_jsonl(DELIVERIES) if r.get("sub") == sub["id"]][-20:]
            self.send_json(200, {"subscription": public_sub(sub), "deliveries": rows})
        else:
            self.send_json(404, {"error": "no such route"})

    def send_static(self, rel):
        root = os.path.realpath(MELODY_DIR)
        full = os.path.realpath(os.path.join(root, urllib.parse.unquote(rel)))
        if os.path.isdir(full):
            full = os.path.join(full, "index.html")
        if not (full == root or full.startswith(root + os.sep)) or not os.path.isfile(full):
            return self.send_json(404, {"error": "not found"})
        size = os.path.getsize(full)
        start, end, status = 0, size - 1, 200
        match = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range", "").strip())
        if match and (match.group(1) or match.group(2)):
            first, last = match.groups()
            if first:
                start = int(first)
                end = min(int(last), size - 1) if last else size - 1
            else:
                start = max(0, size - int(last))
            if start > end or start >= size:
                self.send_response(416)
                self.send_header("Content-Range", "bytes */%d" % size)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            status = 206
        self.send_response(status)
        self.send_header("Content-Type", mimetypes.guess_type(full)[0] or "application/octet-stream")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        if status == 206:
            self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
        self.end_headers()
        if self.command == "HEAD":
            return
        with open(full, "rb") as fh:
            fh.seek(start)
            remaining = end - start + 1
            while remaining > 0:
                chunk = fh.read(min(65536, remaining))
                if not chunk:
                    break
                try:
                    self.wfile.write(chunk)
                except OSError:
                    return
                remaining -= len(chunk)

    # POST
    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/api/subscriptions":
            return self.subscribe()
        if path == "/api/admin/invites":
            if not self.is_admin():
                return self.send_json(401, {"error": "the admin token is needed"})
            data = self.read_body() or {}
            return self.send_json(201, {"code": new_invite(str(data.get("label", ""))[:80])})
        match = re.fullmatch(r"/api/subscriptions/([A-Za-z0-9_-]+)/ping", path)
        if match:
            sub = self.owned(match.group(1))
            if not sub:
                return self.send_json(404, {"error": "no subscription with this id and secret"})
            fact = {"id": "ping:" + uuid.uuid4().hex[:16], "type": "hub.ping", "at": now_iso(),
                    "subscription": sub["id"]}
            ok, status, reason = post_fact(sub, fact)
            return self.send_json(200 if ok else 502, {"delivered": ok, "http": status, "reason": reason})
        self.send_json(404, {"error": "no such route"})

    def subscribe(self):
        client, now = self.client(), time.time()
        with ATTEMPTS_LOCK:
            recent = [t for t in ATTEMPTS.get(client, []) if now - t < 3600]
            recent.append(now)
            ATTEMPTS[client] = recent
        if len(recent) > 10:
            return self.send_json(429, {"error": "too many attempts from this address, try again in an hour"})
        data = self.read_body()
        if data is None:
            return self.send_json(400, {"error": "send a JSON object of at most %d bytes" % MAX_BODY})
        url = str(data.get("url", "")).strip()
        _, _, reason = check_target(url)
        if reason:
            return self.send_json(400, {"error": reason})
        events = data.get("events") or list(EVENT_TYPES)
        if not isinstance(events, list) or any(e not in EVENT_TYPES for e in events):
            return self.send_json(400, {"error": "events may hold: " + ", ".join(EVENT_TYPES)})
        with locked():
            subs = read_json(SUBS_FILE, {})
            try:
                most = int(CFG.get("JAMAI_HUB_MAX_SUBSCRIPTIONS", "200"))
            except ValueError:
                most = 200
            if len(subs) >= most:
                return self.send_json(503, {"error": "this hub accepts no more subscriptions"})
            invite = ""
            if not flag("JAMAI_HUB_OPEN_SUBSCRIPTIONS") and not self.is_admin():
                invite = invite_key(str(data.get("invite", "")).strip())
                invites = read_json(INVITES_FILE, {})
                entry = invites.get(invite)
                if not entry or entry.get("used_by") or time.time() > float(entry.get("expires_epoch", 0)):
                    return self.send_json(403, {"error": "a valid, unused, unexpired invite code is needed to subscribe here"})
            known = facts()
            sub = {"id": "sub_" + secrets.token_urlsafe(9), "url": url, "events": events,
                   "label": str(data.get("label", ""))[:80], "secret": secrets.token_urlsafe(32),
                   "created_at": now_iso(),
                   # the last fact already announced: delivery starts after it ("" = empty ledger)
                   "after_fact": known[-1]["id"] if known else ""}
            subs[sub["id"]] = sub
            write_json(SUBS_FILE, subs)
            if invite:
                invites[invite]["used_by"] = sub["id"]
                write_json(INVITES_FILE, invites)
        self.send_json(201, {"id": sub["id"], "secret": sub["secret"], "events": events,
                             "note": "the secret is shown once: it signs every delivery and manages this subscription"})

    def do_DELETE(self):
        path = urllib.parse.urlsplit(self.path).path
        if not re.fullmatch(r"/api/subscriptions/[A-Za-z0-9_-]+", path):
            return self.send_json(404, {"error": "no such route"})
        sub = self.owned(path.rsplit("/", 1)[1])
        if not sub:
            return self.send_json(404, {"error": "no subscription with this id and secret"})
        with locked():
            subs = read_json(SUBS_FILE, {})
            subs.pop(sub["id"], None)
            write_json(SUBS_FILE, subs)
        self.send_json(200, {"ended": sub["id"]})


def invite_key(code):
    """An invite is kept as its hash: the file never holds a code someone could reuse."""
    return hashlib.sha256(code.encode("utf-8")).hexdigest()


def new_invite(label):
    """A one-use invite code. It opens one subscription and expires after JAMAI_HUB_INVITE_DAYS."""
    code = "inv_" + secrets.token_urlsafe(16)
    try:
        days = float(CFG.get("JAMAI_HUB_INVITE_DAYS", "7"))
    except ValueError:
        days = 7.0
    with locked():
        invites = read_json(INVITES_FILE, {})
        invites[invite_key(code)] = {"label": label, "created_at": now_iso(),
                                     "expires_epoch": int(time.time() + days * 86400), "used_by": ""}
        write_json(INVITES_FILE, invites)
    return code


# ── command line ─────────────────────────────────────────────────────
def serve(argv):
    host, port = CFG.get("JAMAI_HUB_HOST", "127.0.0.1"), CFG.get("JAMAI_HUB_PORT", "8642")
    while argv:
        arg = argv.pop(0)
        if arg == "--host" and argv:
            host = argv.pop(0)
        elif arg == "--port" and argv:
            port = argv.pop(0)
        else:
            sys.exit("jamai-hub serve: unknown option " + arg)
    os.makedirs(HUB_DIR, mode=0o700, exist_ok=True)
    server = http.server.ThreadingHTTPServer((host, int(port)), Handler)
    server.daemon_threads = True
    stop = threading.Event()
    threading.Thread(target=worker, args=(stop,), daemon=True).start()
    print("jamai-hub %s on http://%s:%s/  (melodies: %s · ledger: %s · subscriptions: %s)"
          % (VERSION, host, port, MELODY_DIR, LEDGER,
             "open" if flag("JAMAI_HUB_OPEN_SUBSCRIPTIONS") else "by invite"), flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        server.server_close()


UNIT = """[Unit]
Description=jamai-hub: melody page, subscriptions and webhook delivery
After=network-online.target

[Service]
ExecStart=%s serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
"""


def main(argv):
    command = argv[0] if argv else "help"
    rest = argv[1:]
    if command == "serve":
        serve(rest)
    elif command == "invite":
        print(new_invite(" ".join(rest)[:80]))
    elif command == "subscriptions":
        subs = read_json(SUBS_FILE, {})
        for sub in subs.values():
            print("%s  %s  %s  %s  %s" % (sub["id"], sub["created_at"], ",".join(sub["events"]),
                                          sub["url"], sub.get("label", "")))
        print("%d subscription(s)" % len(subs))
    elif command in ("events", "deliveries"):
        rows = facts() if command == "events" else read_jsonl(DELIVERIES)
        count = int(rest[0]) if rest and rest[0].isdigit() else 10
        for row in rows[-count:]:
            print(json.dumps(row, ensure_ascii=False))
    elif command == "unit":
        sys.stdout.write(UNIT % os.path.realpath(__file__))
    elif command in ("help", "-h", "--help"):
        print(__doc__)
    else:
        sys.exit("jamai-hub: unknown command %s (try: jamai-hub help)" % command)


if __name__ == "__main__":
    main(sys.argv[1:])
